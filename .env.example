# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Essas três variáveis são públicas por natureza (vão para o navegador) e são exigidas
# em desenvolvimento e na Vercel. Nunca coloque a service role key aqui.

# URL do projeto Supabase, ex.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (publishable) do projeto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Único e-mail autorizado a abrir o cofre
NEXT_PUBLIC_ALLOWED_EMAIL=
